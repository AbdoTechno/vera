# ==========================================
# VERA Clinical Intelligence Platform - .gitignore
# ==========================================

# 1. Environment & API Keys (Critical Secrets)
.env
.env.*
!.env.example

# 2. Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 3. Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# 4. Logs & System Runtime Artifacts
*.log
logs/
.system_generated/
.agents/
.gemini/

# 6. IDE, Editors & OS Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# 7. Model weights & Large Binaries
*.safetensors
*.bin
*.pt
*.onnx
